{
  "name": "mapa",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "typecheck": "npm -w server run typecheck && npm -w web run typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/**/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "concurrently": "^9.1.2"
  }
}
